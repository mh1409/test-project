// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

model Notification {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  titleAr   String
  titleEn   String
  bodyAr    String
  bodyEn    String
  data      Json?
  link      String?
  readAt    DateTime? @db.Timestamptz(6)
  dedupeKey String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationDelivery {
  id             String              @id @default(uuid(7)) @db.Uuid
  notificationId String              @db.Uuid
  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  status         String              @default("PENDING") // PENDING | SENT | FAILED | SKIPPED
  provider       String?
  providerMessageId String?
  error          String?
  attempts       Int                 @default(0)
  sentAt         DateTime?           @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)

  @@index([notificationId])
  @@index([status])
  @@map("notification_deliveries")
}

model NotificationPreference {
  userId  String              @db.Uuid
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    String              // NotificationType or "*"
  channel NotificationChannel
  enabled Boolean             @default(true)

  @@id([userId, type, channel])
  @@map("notification_preferences")
}

model PushDevice {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String   // web | ios | android
  token     String   @unique
  lastSeenAt DateTime @default(now()) @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@map("push_devices")
}

// ─────────────────────────────────────────────────────────────────────────────
// PROMOTIONS: COUPONS, FLASH DEALS
// ─────────────────────────────────────────────────────────────────────────────

enum CouponType {
  FIXED
  PERCENTAGE
  FREE_SHIPPING
}

model Coupon {
  id              String     @id @default(uuid(7)) @db.Uuid
  code            String     @unique @db.Citext
  type            CouponType
  value           Int        // minor units for FIXED, bps for PERCENTAGE
  currency        String     @default("SAR")
  descriptionAr   String?
  descriptionEn   String?
  minCartTotal    Int?
  maxDiscount     Int?
  startsAt        DateTime   @db.Timestamptz(6)
  endsAt          DateTime?  @db.Timestamptz(6)
  usageLimit      Int?
  perUserLimit    Int        @default(1)
  usedCount       Int        @default(0)
  firstOrderOnly  Boolean    @default(false)
  sellerId        String?    @db.Uuid // null => platform-funded
  seller          Seller?    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId      String?    @db.Uuid
  category        Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productId       String?    @db.Uuid
  product         Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  isActive        Boolean    @default(true)
  createdById     String?    @db.Uuid
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)
  redemptions     CouponRedemption[]
  orders          Order[]

  @@index([isActive, startsAt, endsAt])
  @@index([sellerId])
  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(uuid(7)) @db.Uuid
  couponId  String   @db.Uuid
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId   String   @unique @db.Uuid
  amount    Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

model FlashDeal {
  id        String   @id @default(uuid(7)) @db.Uuid
  nameAr    String
  nameEn    String
  sellerId  String?  @db.Uuid
  seller    Seller?  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  startsAt  DateTime @db.Timestamptz(6)
  endsAt    DateTime @db.Timestamptz(6)
  status    String   @default("SCHEDULED") // SCHEDULED | ACTIVE | ENDED | CANCELLED
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  items     FlashDealItem[]

  @@index([status, startsAt, endsAt])
  @@map("flash_deals")
}

model FlashDealItem {
  id           String         @id @default(uuid(7)) @db.Uuid
  dealId       String         @db.Uuid
  deal         FlashDeal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId    String         @db.Uuid
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId    String?        @db.Uuid
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  dealPrice    Int
  quantityLimit Int?
  quantitySold Int            @default(0)
  perUserLimit Int            @default(1)

  @@unique([dealId, productId, variantId])
  @@index([productId])
  @@map("flash_deal_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUCTIONS
// ─────────────────────────────────────────────────────────────────────────────

enum AuctionStatus {
  SCHEDULED
  ACTIVE
  ENDED
  SOLD
  UNSOLD
  CANCELLED
}

model Auction {
  id              String        @id @default(uuid(7)) @db.Uuid
  productId       String        @unique @db.Uuid
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId        String        @db.Uuid
  seller          Seller        @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  status          AuctionStatus @default(SCHEDULED)
  currency        String        @default("SAR")
  startingPrice   Int
  reservePrice    Int?
  bidIncrement    Int
  buyNowPrice     Int?
  currentPrice    Int?
  currentBidId    String?       @unique @db.Uuid
  currentBid      Bid?          @relation("CurrentBid", fields: [currentBidId], references: [id], onDelete: SetNull)
  bidCount        Int           @default(0)
  startsAt        DateTime      @db.Timestamptz(6)
  endsAt          DateTime      @db.Timestamptz(6)
  originalEndsAt  DateTime      @db.Timestamptz(6)
  antiSnipeSeconds Int          @default(120)
  maxExtensions   Int           @default(10)
  extensionCount  Int           @default(0)
  winnerId        String?       @db.Uuid
  winningOrderId  String?       @db.Uuid
  version         Int           @default(0)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)
  bids            Bid[]         @relation("AuctionBids")
  autoBids        AutoBid[]

  @@index([status, endsAt])
  @@index([sellerId])
  @@map("auctions")
}

model Bid {
  id         String   @id @default(uuid(7)) @db.Uuid
  auctionId  String   @db.Uuid
  auction    Auction  @relation("AuctionBids", fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId   String   @db.Uuid
  bidder     User     @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  amount     Int
  isAutoBid  Boolean  @default(false)
  isWinning  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  currentFor Auction? @relation("CurrentBid")

  @@index([auctionId, amount(sort: Desc), createdAt])
  @@index([bidderId])
  @@map("bids")
}

model AutoBid {
  auctionId String   @db.Uuid
  userId    String   @db.Uuid
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxAmount Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@id([auctionId, userId])
  @@map("auto_bids")
}

// ─────────────────────────────────────────────────────────────────────────────
// ADMIN, CMS, MODERATION, SUPPORT, SYSTEM
// ─────────────────────────────────────────────────────────────────────────────

model Banner {
  id             String    @id @default(uuid(7)) @db.Uuid
  titleAr        String
  titleEn        String
  subtitleAr     String?
  subtitleEn     String?
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String?
  position       String    @default("HERO") // HERO | SIDEBAR | CATEGORY | CHECKOUT
  locale         String?   // null => all
  sortOrder      Int       @default(0)
  startsAt       DateTime? @db.Timestamptz(6)
  endsAt         DateTime? @db.Timestamptz(6)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  @@index([position, isActive, sortOrder])
  @@map("banners")
}

model HomeSection {
  id        String   @id @default(uuid(7)) @db.Uuid
  type      String   // HomeSectionType
  titleAr   String
  titleEn   String
  config    Json?    // {categoryId, limit, ...}
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([isActive, position])
  @@map("home_sections")
}

model CmsPage {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique @db.Citext
  titleAr     String
  titleEn     String
  bodyAr      String   // sanitized HTML/markdown
  bodyEn      String
  isPublished Boolean  @default(true)
  seoDescriptionAr String?
  seoDescriptionEn String?
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@map("cms_pages")
}

model FaqCategory {
  id       String       @id @default(uuid(7)) @db.Uuid
  slug     String       @unique @db.Citext
  nameAr   String
  nameEn   String
  position Int          @default(0)
  articles FaqArticle[]

  @@map("faq_categories")
}

model FaqArticle {
  id         String      @id @default(uuid(7)) @db.Uuid
  categoryId String      @db.Uuid
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug       String      @unique @db.Citext
  questionAr String
  questionEn String
  answerAr   String
  answerEn   String
  position   Int         @default(0)
  isPublished Boolean    @default(true)
  viewCount  Int         @default(0)
  createdAt  DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(6)

  @@index([categoryId, position])
  @@map("faq_articles")
}

enum ReportTargetType {
  PRODUCT
  SELLER
  REVIEW
  MESSAGE
  USER
  STORE
  QUESTION
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model Report {
  id          String           @id @default(uuid(7)) @db.Uuid
  reporterId  String           @db.Uuid
  reporter    User             @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType  ReportTargetType
  targetId    String           @db.Uuid
  reason      String
  description String?          @db.VarChar(2000)
  evidence    Json?
  status      ReportStatus     @default(OPEN)
  resolvedById String?         @db.Uuid
  resolution  String?
  resolvedAt  DateTime?        @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

enum ModerationActionType {
  APPROVE
  REJECT
  HIDE
  SUSPEND
  BAN
  RESTORE
  WARN
}

/// Every moderation decision with mandatory reason. Append-only.
model ModerationAction {
  id          String               @id @default(uuid(7)) @db.Uuid
  moderatorId String               @db.Uuid
  moderator   User                 @relation("Moderator", fields: [moderatorId], references: [id], onDelete: Restrict)
  targetType  String               // PRODUCT | REVIEW | USER | STORE | MESSAGE | QUESTION
  targetId    String               @db.Uuid
  productId   String?              @db.Uuid
  product     Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  action      ModerationActionType
  reason      String
  reportId    String?              @db.Uuid
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)

  @@index([targetType, targetId, createdAt])
  @@index([moderatorId])
  @@map("moderation_actions")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String              @id @default(uuid(7)) @db.Uuid
  ticketNumber String             @unique
  customerId  String              @db.Uuid
  customer    User                @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  agentId     String?             @db.Uuid
  agent       User?               @relation("TicketAgent", fields: [agentId], references: [id], onDelete: SetNull)
  subject     String
  category    String              @default("GENERAL")
  priority    String              @default("NORMAL")
  status      SupportTicketStatus @default(OPEN)
  orderId     String?             @db.Uuid
  resolvedAt  DateTime?           @db.Timestamptz(6)
  closedAt    DateTime?           @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)
  messages    SupportMessage[]

  @@index([customerId])
  @@index([status, priority, createdAt])
  @@index([agentId])
  @@map("support_tickets")
}

model SupportMessage {
  id          String        @id @default(uuid(7)) @db.Uuid
  ticketId    String        @db.Uuid
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String        @db.Uuid
  isAgent     Boolean       @default(false)
  isInternal  Boolean       @default(false)
  body        String        @db.VarChar(6000)
  attachments Json?
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model SystemSetting {
  key         String   @id
  value       Json
  description String?
  isPublic    Boolean  @default(false)
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@map("system_settings")
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  rules       Json?    // {rolloutPercent, allowUserIds, allowRoles}
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@map("feature_flags")
}

/// Immutable admin audit log.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)
  actorType  String   @default("USER") // USER | SYSTEM | IMPERSONATION
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// EVENTS: TRANSACTIONAL OUTBOX, IDEMPOTENT CONSUMERS, TRACKING
// ─────────────────────────────────────────────────────────────────────────────

model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String
  aggregateType String
  aggregateId   String
  payload       Json
  correlationId String?
  version       Int       @default(1)
  status        String    @default("PENDING") // PENDING | PUBLISHED | FAILED
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(6)
  lastError     String?
  publishedAt   DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

/// Dedupe table for idempotent consumers: (consumer, eventId) processed once.
model ProcessedEvent {
  consumer    String
  eventId     String   @db.Uuid
  processedAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@index([processedAt])
  @@map("processed_events")
}

/// Dead-letter store for jobs/events that exhausted retries.
model DeadLetter {
  id         String    @id @default(uuid(7)) @db.Uuid
  source     String    // queue name or consumer
  reference  String?   // job id / event id
  payload    Json
  error      String
  attempts   Int
  resolvedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([source, resolvedAt])
  @@map("dead_letters")
}

model TrackingEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  userId      String?  @db.Uuid
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonymousId String?
  sessionId   String?
  properties  Json?
  locale      String?
  path        String?
  referrer    String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@map("tracking_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// MEDIA UPLOADS
// ─────────────────────────────────────────────────────────────────────────────

model MediaUpload {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     String    // PRODUCT_IMAGE | PRODUCT_VIDEO | PRODUCT_DOCUMENT | AVATAR | STORE_LOGO | SELLER_DOCUMENT | RETURN_EVIDENCE | MESSAGE_ATTACHMENT | DIGITAL_ASSET
  bucket      String
  objectKey   String    @unique
  mimeType    String
  sizeBytes   Int
  status      String    @default("PENDING") // PENDING | UPLOADED | PROCESSED | REJECTED | DELETED
  scanStatus  String    @default("PENDING") // PENDING | CLEAN | INFECTED | SKIPPED
  width       Int?
  height      Int?
  variants    Json?
  publicUrl   String?
  expiresAt   DateTime  @db.Timestamptz(6) // pending uploads are garbage collected after this
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  @@index([userId, purpose])
  @@index([status, expiresAt])
  @@map("media_uploads")
}

// ─────────────────────────────────────────────────────────────────────────────
// RISK / FRAUD, REFERRALS
// ─────────────────────────────────────────────────────────────────────────────

model RiskAssessment {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId   String?  @db.Uuid
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  context   String   // LOGIN | CHECKOUT | REFUND | REGISTRATION
  score     Int
  level     String   // LOW | MEDIUM | HIGH | CRITICAL
  signals   Json     // [{code, weight, detail}]
  decision  String   // ALLOW | REVIEW | BLOCK
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@index([level, createdAt])
  @@map("risk_assessments")
}

model ReferralCode {
  userId    String     @id @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String     @unique @db.Citext
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  referrals Referral[]

  @@map("referral_codes")
}

model Referral {
  id           String       @id @default(uuid(7)) @db.Uuid
  codeUserId   String       @db.Uuid
  code         ReferralCode @relation(fields: [codeUserId], references: [userId], onDelete: Cascade)
  refereeId    String       @unique @db.Uuid
  referee      User         @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)
  status       String       @default("PENDING") // PENDING | QUALIFIED | REWARDED | VOID
  rewardType   String?
  rewardAmount Int?
  qualifiedAt  DateTime?    @db.Timestamptz(6)
  rewardedAt   DateTime?    @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)

  @@index([codeUserId])
  @@map("referrals")
}
