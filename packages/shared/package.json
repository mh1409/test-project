{
  "name": "@souq/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./money": {
      "types": "./dist/money/index.d.ts",
      "default": "./dist/money/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./state-machine": {
      "types": "./dist/state-machine/index.d.ts",
      "default": "./dist/state-machine/index.js"
    },
    "./ids": {
      "types": "./dist/ids/index.d.ts",
      "default": "./dist/ids/index.js"
    },
    "./pagination": {
      "types": "./dist/pagination/index.d.ts",
      "default": "./dist/pagination/index.js"
    },
    "./time": {
      "types": "./dist/time/index.d.ts",
      "default": "./dist/time/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "default": "./dist/security/index.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "default": "./dist/text/index.js"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rm -rf dist .turbo coverage",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@souq/eslint-config": "workspace:*",
    "@souq/tsconfig": "workspace:*",
    "eslint": "^9.39.5",
    "typescript": "5.9.3",
    "vitest": "^3.2.7",
    "@types/node": "^22.20.1"
  },
  "files": [
    "dist"
  ]
}
