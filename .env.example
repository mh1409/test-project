# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME="Souq Marketplace"
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
API_URL=http://localhost:3001
API_PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
TRUST_PROXY=false

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace?schema=public
DATABASE_POOL_MAX=20

# ── Redis (cache, rate limits, queues, locks, websocket adapter) ───────────
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false

# ── Search ─────────────────────────────────────────────────────────────────
# opensearch | database  (database = Postgres full-text fallback)
SEARCH_ENGINE=database
OPENSEARCH_URL=http://localhost:9200
SEARCH_INDEX_PREFIX=souq

# ── Event bus (transactional outbox dispatch) ──────────────────────────────
# memory | redis | rabbitmq
EVENT_BUS=redis
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── Object storage (S3 compatible; MinIO locally) ──────────────────────────
# s3 | local
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PUBLIC=souq-public
S3_BUCKET_PRIVATE=souq-private
S3_FORCE_PATH_STYLE=true
LOCAL_STORAGE_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false
MFA_ISSUER=Souq
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ── Providers (mock/log adapters ship by default) ──────────────────────────
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret-change-me
SHIPPING_PROVIDER=mock
EMAIL_PROVIDER=log
SMTP_URL=
EMAIL_FROM="Souq <no-reply@souq.local>"
SMS_PROVIDER=log
PUSH_PROVIDER=log
PAYOUT_PROVIDER=mock
VIRUS_SCANNER=mock

# ── Marketplace business defaults ──────────────────────────────────────────
DEFAULT_CURRENCY=SAR
DEFAULT_LOCALE=ar
DEFAULT_TIMEZONE=Asia/Riyadh
DEFAULT_COMMISSION_BPS=1000
DEFAULT_VAT_BPS=1500
INVENTORY_RESERVATION_MINUTES=20
PAYOUT_HOLD_DAYS=7
AUCTION_ANTI_SNIPE_SECONDS=120
ABANDONED_CART_HOURS=3

# ── Feature flags (runtime overrides live in the admin panel) ──────────────
FEATURE_AUCTIONS=true
FEATURE_DIGITAL_PRODUCTS=true
FEATURE_RECOMMENDATIONS_V2=false
FEATURE_GUEST_CHECKOUT=true
FEATURE_WALLET=true
FEATURE_REFERRALS=false
FEATURE_IMPERSONATION=false

# ── Observability ──────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=souq-api
METRICS_ENABLED=true
RATE_LIMIT_ENABLED=true

# ── Frontend (public) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:3001
