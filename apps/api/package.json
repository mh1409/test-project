{
  "name": "@souq/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker/main",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "search:reindex": "node dist/scripts/reindex.js",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/platform-socket.io": "11.2.3",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/websockets": "11.2.3",
    "@opensearch-project/opensearch": "^3.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@souq/config": "workspace:*",
    "@souq/database": "workspace:*",
    "@souq/i18n": "workspace:*",
    "@souq/observability": "workspace:*",
    "@souq/shared": "workspace:*",
    "@souq/types": "workspace:*",
    "@souq/validation": "workspace:*",
    "amqplib": "^0.10.9",
    "bullmq": "^5.56.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.8.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.6.1",
    "jose": "^6.2.10",
    "nodemailer": "^7.0.13",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.34.3",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.2.3",
    "@souq/eslint-config": "workspace:*",
    "@souq/testing": "workspace:*",
    "@souq/tsconfig": "workspace:*",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.5",
    "@types/amqplib": "^0.10.7",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^7.0.4",
    "@types/qrcode": "^1.5.5",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "typescript": "5.9.3",
    "unplugin-swc": "^1.5.5",
    "vitest": "^3.2.7"
  }
}
